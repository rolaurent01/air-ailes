---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PhotoCard from '../../components/PhotoCard.astro';
import Lightbox from '../../components/Lightbox.astro';
import { mixGallery } from '../../lib/gallery-mix';
import { composerRangees, format } from '../../lib/gallery-layout';

const allPhotos = await getCollection('galeries');
const photos = mixGallery(allPhotos);
const rangees = composerRangees(photos);

// Hauteur maximale d'une rangée : la même valeur sert au CSS (--hauteur-max) et à l'attribut sizes
const HAUTEUR_MAX_PX = 820;
const pourcent = (n: number) => Math.round(n * 94);

/** Largeur réelle d'une photo, pour que le navigateur télécharge la bonne définition */
function tailles(ratio: number, part: number, mobile: string): string {
  return `(max-width: 768px) ${mobile}, min(${pourcent(part)}vw, ${Math.round(ratio * HAUTEUR_MAX_PX)}px)`;
}

const lightboxPhotos = photos.map((p) => ({
  cloudinary_id: p.data.cloudinary_id,
  title: p.data.title,
  alt: p.data.alt,
  location: p.data.location,
  date: p.data.date?.toISOString(),
}));
---

<BaseLayout
  title="Galerie"
  description="Portfolio photographique Air-Ailes — paysages, nature, macro et détails."
  image={photos[0]?.data.cloudinary_id}
>
  <section class="gallery-page">
    <div class="gallery-page__header">
      <h1 class="gallery-page__title" id="gallery-title">Galerie</h1>
      <p class="gallery-page__count">{photos.length} photographies</p>
    </div>

    <div class="galerie" style={`--hauteur-max: min(78vh, ${HAUTEUR_MAX_PX}px);`}>
      {rangees.map((rangee) => (
        rangee.type === 'mosaique' ? (
          <div class="galerie__mosaique">
            {rangee.photos.map((photo, i) => (
              <PhotoCard
                title={photo.data.title}
                cloudinaryId={photo.data.cloudinary_id}
                alt={photo.data.alt}
                focalPoint={photo.data.focal_point}
                dominantColor={photo.data.dominant_color}
                orientation={photo.data.orientation === 'portrait' ? 'portrait' : 'landscape'}
                index={photos.indexOf(photo)}
                sizes={i === 0
                  ? tailles(2 / 3, 8 / 17, 'calc(100vw - 3rem)')
                  : tailles(1.5, 9 / 17, 'calc(100vw - 3rem)')}
              />
            ))}
          </div>
        ) : (
          <div
            class:list={['galerie__rangee', { 'galerie__rangee--seule': rangee.photos.length === 1 }]}
            style={`--somme: ${rangee.somme.toFixed(3)}; --n: ${rangee.photos.length};`}
          >
            {rangee.photos.map((photo) => {
              const ratio = format(photo.data);
              const portrait = photo.data.orientation === 'portrait';
              return (
                <PhotoCard
                  title={photo.data.title}
                  cloudinaryId={photo.data.cloudinary_id}
                  alt={photo.data.alt}
                  focalPoint={photo.data.focal_point}
                  dominantColor={photo.data.dominant_color}
                  orientation={portrait ? 'portrait' : 'landscape'}
                  index={photos.indexOf(photo)}
                  style={`--format: ${ratio.toFixed(3)};`}
                  sizes={tailles(ratio, ratio / rangee.somme, portrait ? 'calc(50vw - 2rem)' : 'calc(100vw - 3rem)')}
                />
              );
            })}
          </div>
        )
      ))}
    </div>
  </section>

  <Lightbox photos={lightboxPhotos} />
</BaseLayout>

<style>
  .gallery-page {
    padding-block: var(--space-3xl) var(--space-2xl);
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--space-lg);
  }

  .gallery-page__header {
    text-align: center;
    margin-bottom: var(--space-2xl);
  }

  .gallery-page__title {
    font-size: clamp(2rem, 6vw, var(--font-size-2xl));
    font-weight: var(--font-weight-light);
    letter-spacing: var(--letter-spacing-wider);
    color: var(--color-text-primary);
    margin-bottom: var(--space-xs);
  }

  .gallery-page__count {
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
    letter-spacing: var(--letter-spacing-uppercase);
    text-transform: uppercase;
    opacity: 0.6;
  }

  /* --- Galerie en rangées (découpe : src/lib/gallery-layout.ts) ---
     Dans une rangée, chaque photo grandit en proportion de son format (flex-grow = largeur / hauteur) :
     toutes ont la même hauteur, sans recadrage. La largeur maximale de la rangée limite sa hauteur
     à --hauteur-max ; une rangée qui l'atteint se centre, avec de l'air autour. */
  .galerie {
    --galerie-gap: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: var(--galerie-gap);
  }

  .galerie__rangee {
    display: flex;
    gap: var(--galerie-gap);
    width: 100%;
    max-width: calc(var(--somme) * var(--hauteur-max) + (var(--n) - 1) * var(--galerie-gap));
    margin-inline: auto;
  }

  .galerie__rangee > :global(.photo-card) {
    flex: var(--format) 1 0;
    min-width: 0;
    margin: 0;
  }

  /* Mosaïque : un portrait en grand, deux paysages empilés à côté.
     Colonnes 8 / 9 : la hauteur du portrait égale celle des deux paysages. */
  .galerie__mosaique {
    display: grid;
    grid-template-columns: 8fr 9fr;
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: var(--galerie-gap);
    width: 100%;
    max-width: calc(var(--hauteur-max) * 2 / 3 * 17 / 8 + var(--galerie-gap));
    margin-inline: auto;
  }

  .galerie__mosaique > :global(.photo-card) {
    margin: 0;
    min-width: 0;
  }

  .galerie__mosaique > :global(.photo-card:first-child) {
    grid-row: span 2;
  }

  /* Les deux paysages s'alignent sur la hauteur du portrait : leur image n'impose plus sa propre
     hauteur (position absolue) et remplit sa case, avec un recadrage de quelques pixels. */
  @media (min-width: 769px) {
    .galerie__mosaique > :global(.photo-card:not(:first-child)) {
      min-height: 0;
    }

    .galerie__mosaique > :global(.photo-card:not(:first-child) .photo-card__trigger),
    .galerie__mosaique > :global(.photo-card:not(:first-child) .protected-image) {
      height: 100%;
      aspect-ratio: auto;
    }

    .galerie__mosaique > :global(.photo-card:not(:first-child) .protected-image__main) {
      position: absolute;
      inset: 0;
    }
  }

  /* Mobile : paysages en pleine largeur, portraits par deux */
  @media (max-width: 768px) {
    .gallery-page {
      padding-inline: var(--space-md);
    }

    .galerie {
      --galerie-gap: 1rem;
    }

    .galerie__rangee,
    .galerie__mosaique {
      display: flex;
      flex-wrap: wrap;
      max-width: none;
    }

    .galerie__rangee > :global(.photo-card),
    .galerie__mosaique > :global(.photo-card) {
      flex: 1 1 100%;
    }

    .galerie__rangee > :global(.photo-card--portrait),
    .galerie__mosaique > :global(.photo-card--portrait) {
      flex: 1 1 calc(50% - var(--galerie-gap) / 2);
    }
  }

  /* Large screens: more breathing room */
  @media (min-width: 1440px) {
    .gallery-page {
      padding-inline: var(--space-xl);
    }
  }
</style>

<script>
  import { animateText } from '../../lib/animations/text';
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { ANIMATION_EASING } from '../../lib/constants';

  gsap.registerPlugin(ScrollTrigger);

  function initGalleryPage(): void {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const title = document.getElementById('gallery-title');
    if (!title) return;

    ScrollTrigger.getAll().forEach((t) => t.kill());
    animateText(title, { mode: 'letters', staggerDelay: 0.05 });

    const cards = document.querySelectorAll<HTMLElement>('.photo-card');
    gsap.set(cards, { opacity: 0, y: 40 });
    cards.forEach((card, i) => {
      gsap.to(card, {
        opacity: 1,
        y: 0,
        duration: 0.7,
        ease: ANIMATION_EASING,
        scrollTrigger: { trigger: card, start: 'top bottom-=8%', once: true },
      });
    });
  }

  initGalleryPage();
  document.addEventListener('astro:page-load', () => {
    initGalleryPage();
  });
</script>
