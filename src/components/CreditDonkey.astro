---
// Crédit Donkey v1.1.0. Fichier fabriqué par source/fabriquer.mjs : ne pas le modifier à la main.
// Usage : <CreditDonkey slug="slug-du-projet" />
// Réglages : lang "fr" (défaut) ou "en" ; variante "monogramme" (défaut, footer clair),
// "monogramme-blanc" (footer foncé), "auto" (site avec un mode sombre) ou "texte"
// (footer sur une photo) ; avec "auto", modeSombre "systeme" (défaut, le site suit
// le réglage de l'appareil) ou "bouton" (le site a son propre bouton clair/sombre).

type Variante = 'monogramme' | 'monogramme-blanc' | 'auto' | 'texte';
type ModeSombre = 'systeme' | 'bouton';

const SLUG_VALIDE = /^[a-z0-9]+(?:-[a-z0-9]+)*$/;

const TEXTES = {
  "fr": {
    "intro": "Conçu par",
    "nouvelOnglet": "(nouvel onglet)"
  },
  "en": {
    "intro": "Designed by",
    "nouvelOnglet": "(opens in a new tab)"
  }
} as const;

const COULEUR = 'data:image/webp;base64,';
const BLANC = 'data:image/webp;base64,';

// La variante auto porte les deux monogrammes : le CSS montre la couleur en mode
// clair et le blanc en mode sombre.
const IMAGES: Record<Variante, { src: string; classe?: string }[]> = {
  monogramme: [{ src: COULEUR }],
  'monogramme-blanc': [{ src: BLANC }],
  auto: [
    { src: COULEUR, classe: 'dc-credit__monogramme--clair' },
    { src: BLANC, classe: 'dc-credit__monogramme--sombre' },
  ],
  texte: [],
};

interface Props {
  slug: string;
  lang?: 'fr' | 'en';
  variante?: Variante;
  modeSombre?: ModeSombre;
}

const { slug, lang = 'fr', variante = 'monogramme', modeSombre = 'systeme' } = Astro.props;

if (!SLUG_VALIDE.test(slug)) {
  throw new Error(`CreditDonkey : slug « ${slug} » invalide. Minuscules, chiffres et tirets seulement.`);
}

const texte = TEXTES[lang];
const images = IMAGES[variante];
const href = `https://donkey-corp.fr/?utm_source=${slug}&utm_medium=credit`;
---

<p
  class:list={['dc-credit', images.length > 0 && 'dc-credit--monogramme']}
  lang={lang}
  data-sombre={variante === 'auto' ? modeSombre : undefined}
>
  <span>{texte.intro}</span>
  <a class="dc-credit__lien" href={href} target="_blank" rel="noopener">
    {images.map(({ src, classe }) => (
      <img class:list={['dc-credit__monogramme', classe]} src={src} alt="" width="25" height="24" decoding="async" />
    ))}
    <span class="dc-credit__nom">Donkey Corp</span>
    <span class="dc-credit__masque"> {texte.nouvelOnglet}</span>
  </a>
</p>

<style is:global>
/* Le crédit hérite de la couleur et de la police du footer : rien n'est imposé.
   « Discret » veut dire petit, jamais transparent : une opacité réduite casserait
   le contraste choisi pour le footer. */
.dc-credit {
  display: inline-flex;
  flex-wrap: wrap;
  align-items: center;
  column-gap: 0.4em;
  margin: 0;
  color: inherit;
  font-family: inherit;
  font-size: var(--dc-credit-taille, 0.8125rem);
  line-height: 1.5;
}

/* Zone de protection de la charte : la moitié de la hauteur du monogramme (12 px)
   tout autour de lui. */
.dc-credit--monogramme {
  column-gap: 12px;
  padding-block: 12px;
}

/* Zone cliquable d'au moins 24 px de haut (WCAG 2.2, critère 2.5.8). */
.dc-credit__lien {
  display: inline-flex;
  align-items: center;
  gap: 7px; /* écart monogramme-texte de la charte : 0,3 × 24 px */
  min-height: 24px;
  border-radius: 2px;
  color: inherit;
  text-decoration: none;
}

/* Souligné : la couleur étant celle du footer, c'est lui qui signale le lien. */
.dc-credit__nom {
  text-decoration: underline;
  text-decoration-thickness: 1px;
  text-underline-offset: 0.2em;
}

.dc-credit__lien:hover .dc-credit__nom {
  text-decoration-thickness: 2px;
}

.dc-credit__lien:focus-visible {
  outline: 2px solid currentColor;
  outline-offset: 2px;
}

/* 24 px de haut : taille minimale du monogramme dans la charte. */
.dc-credit__monogramme {
  display: block;
  flex: none;
  width: 25px;
  height: 24px;
  max-width: none;
}

/* Variante auto : le monogramme couleur en mode clair, le blanc en mode sombre. */
.dc-credit__monogramme--sombre {
  display: none;
}

/* Le site suit le réglage de l'appareil (modeSombre="systeme"). */
@media (prefers-color-scheme: dark) {
  [data-sombre="systeme"] .dc-credit__monogramme--clair {
    display: none;
  }

  [data-sombre="systeme"] .dc-credit__monogramme--sombre {
    display: block;
  }
}

/* Le site a son propre bouton (modeSombre="bouton") : il pose la classe « dark »
   ou l'attribut data-theme="dark" sur la page, comme Tailwind ou next-themes.
   Sans l'un des deux, le site est en mode clair, quel que soit l'appareil. */
.dark [data-sombre="bouton"] .dc-credit__monogramme--clair,
[data-theme="dark"] [data-sombre="bouton"] .dc-credit__monogramme--clair {
  display: none;
}

.dark [data-sombre="bouton"] .dc-credit__monogramme--sombre,
[data-theme="dark"] [data-sombre="bouton"] .dc-credit__monogramme--sombre {
  display: block;
}

/* Lu par les lecteurs d'écran, invisible à l'écran. */
.dc-credit__masque {
  position: absolute;
  width: 1px;
  height: 1px;
  margin: -1px;
  padding: 0;
  overflow: hidden;
  clip-path: inset(50%);
  white-space: nowrap;
  border: 0;
}
</style>
