---
import BaseLayout from './BaseLayout.astro';
import FilAriane from '../components/FilAriane.astro';
import NavParcours from '../components/NavParcours.astro';
import OuJenSuis from '../components/OuJenSuis.astro';
import Progression from '../components/Progression.astro';
import type { Lecon } from '../lib/parcours';
import { SOCIAL_LINKS } from '../lib/constants';

interface Lien {
  href: string;
  etiquette: string;
  titre: string;
}

interface Props {
  title: string;
  slug: string;
  date: Date;
  misAJour: Date;
  excerpt: string;
  /** Suite de « À la fin de cette leçon, vous saurez… » */
  objectif: string;
  coverSvg: string;
  /** Ex. « Module 1 · Leçon 3 » */
  badge: string;
  niveau: string;
  tempsLecture: number;
  filAriane: { libelle: string; href?: string }[];
  precedent: Lien;
  suivant: Lien;
  parcours: Lecon[];
}

const {
  title, slug, date, misAJour, excerpt, objectif, coverSvg, badge, niveau, tempsLecture, filAriane, precedent, suivant,
  parcours,
} = Astro.props;

const misAJourTexte = misAJour.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout
  title={title}
  description={excerpt}
  ogImage={`/og/${slug}.png`}
  type="article"
  publishedDate={date.toISOString()}
  modifiedDate={misAJour.toISOString()}
>
  <div class="blog-progress" id="blog-progress"></div>

  <article class="blog-article">
    <header class="blog-article__hero">
      <div class="blog-article__cover" id="blog-cover">
        <img src={coverSvg} alt="" width="600" height="400" />
      </div>
      <div class="blog-article__hero-gradient"></div>
      <div class="blog-article__hero-content">
        <FilAriane elements={filAriane} />
        <h1 class="blog-article__title" id="blog-title">{title}</h1>
        <div class="blog-article__meta">
          <span class="blog-article__tags">
            <span class="blog-article__tag">{badge}</span>
            <span class="blog-article__tag">{niveau}</span>
          </span>
          <span>{tempsLecture} min de lecture</span>
          <span>Mis à jour le <time datetime={misAJour.toISOString()}>{misAJourTexte}</time></span>
        </div>
      </div>
    </header>

    <div class="blog-article__prose">
      <aside class="encadre encadre--objectif">
        <p class="encadre__label">Objectif</p>
        <p>À la fin de cette leçon, vous saurez {objectif}</p>
      </aside>

      <slot />
    </div>

    <div class="lecon-fait">
      <label class="lecon-fait__case">
        <input type="checkbox" data-progression-case={slug} />
        <span>J'ai fait l'exercice</span>
      </label>
      <p class="lecon-fait__aide">Mémorisé dans ce navigateur uniquement, sans compte à créer.</p>
    </div>

    <NavParcours precedent={precedent} suivant={suivant} ariaLabel="Navigation entre les leçons" />

    <OuJenSuis parcours={parcours} slugCourant={slug} />

    <aside class="lecon-fin" aria-label="Pour continuer">
      <a href="/galeries">Voir où ça mène : les galeries</a>
      <span aria-hidden="true">·</span>
      <a href="/a-propos#contact">Un tirage d'art</a>
      <span aria-hidden="true">·</span>
      <a href={SOCIAL_LINKS.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
    </aside>
  </article>
  <Progression />
</BaseLayout>

<style>
  /* --- Progress bar --- */
  .blog-progress {
    position: fixed;
    top: 0;
    left: 0;
    width: 0%;
    height: 2px;
    background: var(--color-text-primary);
    z-index: 9999;
    transition: none;
    pointer-events: none;
    opacity: 0.6;
  }

  /* --- Hero --- */
  .blog-article__hero {
    position: relative;
    height: 70vh;
    min-height: 400px;
    max-height: 700px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .blog-article__cover {
    position: absolute;
    inset: 0;
    will-change: transform;
  }

  .blog-article__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .blog-article__hero-gradient {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to bottom,
      rgba(5, 5, 5, 0.1) 0%,
      rgba(5, 5, 5, 0.5) 60%,
      rgba(5, 5, 5, 0.9) 100%
    );
  }

  .blog-article__hero-content {
    position: relative;
    z-index: 2;
    padding: var(--space-xl) var(--container-padding);
    max-width: var(--container-max);
    margin-inline: auto;
    width: 100%;
  }

  .blog-article__hero-content :global(.fil-ariane) {
    margin-bottom: var(--space-sm);
  }

  .blog-article__title {
    font-size: clamp(1.8rem, 5vw, var(--font-size-2xl));
    font-weight: var(--font-weight-light);
    letter-spacing: var(--letter-spacing-wide);
    color: var(--color-text-primary);
    max-width: 20ch;
    opacity: 0;
    transform: translateY(20px);
  }

  .blog-article__meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-top: var(--space-sm);
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
  }

  .blog-article__meta {
    flex-wrap: wrap;
  }

  .blog-article__tags {
    display: flex;
    gap: 8px;
  }

  .blog-article__tag {
    padding: 2px 8px;
    border: 1px solid rgba(240, 237, 232, 0.1);
    border-radius: 2px;
    font-size: var(--font-size-xs);
  }

  /* --- Prose --- */
  .blog-article__prose {
    max-width: 65ch;
    margin-inline: auto;
    padding: var(--space-2xl) var(--container-padding);
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--color-text-primary);
  }

  .blog-article__prose :global(h2) {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-light);
    letter-spacing: var(--letter-spacing-wide);
    margin-top: 4rem;
    margin-bottom: var(--space-md);
    color: var(--color-text-primary);
  }

  .blog-article__prose :global(h3) {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-regular);
    margin-top: var(--space-lg);
    margin-bottom: var(--space-sm);
    color: var(--color-text-primary);
  }

  .blog-article__prose :global(p) {
    margin-bottom: 1.5em;
    max-width: none;
  }

  .blog-article__prose :global(blockquote) {
    border-left: 1px solid var(--color-text-secondary);
    padding-left: var(--space-md);
    font-style: italic;
    opacity: 0.8;
    margin-block: var(--space-lg);
  }

  .blog-article__prose :global(img) {
    width: 100%;
    border-radius: 4px;
    margin-block: var(--space-lg);
  }

  .blog-article__prose :global(a) {
    color: var(--color-text-primary);
    text-decoration: none;
    border-bottom: 1px solid rgba(240, 237, 232, 0.3);
    transition: border-color var(--duration-hover) var(--ease-out-expo);
  }

  .blog-article__prose :global(a:hover) {
    border-color: var(--color-text-primary);
  }

  /* --- SVG Illustrations --- */
  .blog-article__prose :global(.svg-illustration) {
    display: flex;
    justify-content: center;
    margin-block: var(--space-xl);
  }

  .blog-article__prose :global(.svg-illustration svg) {
    max-width: 600px;
    width: 100%;
    height: auto;
  }

  .blog-article__prose :global(.svg-caption) {
    text-align: center;
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
    letter-spacing: var(--letter-spacing-wide);
    margin-top: var(--space-xs);
    font-style: italic;
  }

  /* --- Tableaux et chemins longs : jamais plus larges que l'écran --- */
  .blog-article__prose :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
  }

  .blog-article__prose :global(code) {
    overflow-wrap: anywhere;
  }

  /* --- Encadrés : Objectif, À retenir, Exercice --- */
  .blog-article__prose :global(.encadre) {
    border: 1px solid var(--color-border-subtle);
    border-radius: 2px;
    background: rgba(240, 237, 232, 0.02);
    padding: var(--space-md) var(--space-lg);
    margin-block: var(--space-xl);
  }

  .blog-article__prose :global(.encadre--objectif) {
    margin-top: 0;
  }

  .blog-article__prose :global(.encadre + .encadre) {
    margin-top: calc(var(--space-md) - var(--space-xl));
  }

  .blog-article__prose :global(.encadre__label) {
    font-size: var(--font-size-xs);
    letter-spacing: var(--letter-spacing-uppercase);
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-xs);
  }

  .blog-article__prose :global(.encadre > :first-child) {
    margin-top: 0;
  }

  .blog-article__prose :global(.encadre > :last-child) {
    margin-bottom: 0;
  }

  @media (max-width: 768px) {
    .blog-article__prose :global(.encadre) {
      padding: var(--space-sm) var(--space-md);
    }
  }

  /* --- Case « J'ai fait l'exercice » --- */
  .lecon-fait {
    max-width: 65ch;
    margin-inline: auto;
    padding: 0 var(--container-padding) var(--space-xl);
    text-align: center;
  }

  .lecon-fait__case {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 10px 20px;
    border: 1px solid var(--color-border-subtle);
    border-radius: 2px;
    font-size: var(--font-size-sm);
    letter-spacing: var(--letter-spacing-wide);
    color: var(--color-text-primary);
    cursor: pointer;
    transition: border-color var(--duration-hover) var(--ease-out-expo), background var(--duration-hover) var(--ease-out-expo);
  }

  .lecon-fait__case:hover {
    border-color: rgba(240, 237, 232, 0.3);
  }

  .lecon-fait__case:has(input:checked) {
    border-color: rgba(240, 237, 232, 0.3);
    background: rgba(240, 237, 232, 0.05);
  }

  .lecon-fait__case input {
    appearance: none;
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    margin: 0;
    border: 1px solid rgba(240, 237, 232, 0.4);
    border-radius: 2px;
    display: grid;
    place-content: center;
    cursor: pointer;
  }

  .lecon-fait__case input::after {
    content: '';
    width: 8px;
    height: 4px;
    border-left: 1.5px solid var(--color-bg-primary);
    border-bottom: 1.5px solid var(--color-bg-primary);
    transform: translateY(-1px) rotate(-45deg);
    opacity: 0;
  }

  .lecon-fait__case input:checked {
    background: var(--color-text-primary);
    border-color: var(--color-text-primary);
  }

  .lecon-fait__case input:checked::after {
    opacity: 1;
  }

  .lecon-fait__case input:focus-visible {
    outline: 1px solid var(--color-text-primary);
    outline-offset: 2px;
  }

  .lecon-fait__aide {
    margin-top: var(--space-xs);
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
    letter-spacing: var(--letter-spacing-wide);
  }

  /* --- Fin de leçon --- */
  .lecon-fin {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 12px;
    max-width: 65ch;
    margin-inline: auto;
    padding: 0 var(--container-padding) var(--space-2xl);
    font-size: var(--font-size-xs);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .lecon-fin a {
    color: var(--color-text-secondary);
    transition: color var(--duration-hover) var(--ease-out-expo);
  }

  .lecon-fin a:hover {
    color: var(--color-text-primary);
    opacity: 1;
  }

  /* --- Pour aller plus loin links --- */
  .blog-article__prose :global(h2:last-of-type + p a),
  .blog-article__prose :global(.further-reading a) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  /* --- Ordered/Unordered lists --- */
  .blog-article__prose :global(ol),
  .blog-article__prose :global(ul) {
    padding-left: 1.5em;
    margin-bottom: 1.5em;
  }

  .blog-article__prose :global(li) {
    margin-bottom: 0.5em;
    line-height: 1.7;
  }

  .blog-article__prose :global(strong) {
    font-weight: var(--font-weight-regular);
    color: var(--color-text-primary);
  }

</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { ANIMATION_EASING } from '../lib/constants';

  gsap.registerPlugin(ScrollTrigger);

  let progressController: AbortController | null = null;

  function initBlogArticle(): void {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const titleEl = document.getElementById('blog-title');
    if (!titleEl) {
      progressController?.abort();
      progressController = null;
      return;
    }
    ScrollTrigger.getAll().forEach((t) => t.kill());
    const coverEl = document.getElementById('blog-cover');
    const progressEl = document.getElementById('blog-progress');

    if (titleEl && !reducedMotion) {
      gsap.to(titleEl, {
        opacity: 1, y: 0, duration: 0.6, delay: 0.3, ease: ANIMATION_EASING,
      });
    } else if (titleEl) {
      titleEl.style.opacity = '1';
      titleEl.style.transform = 'none';
    }

    if (coverEl && !reducedMotion) {
      gsap.to(coverEl, {
        yPercent: 15,
        ease: 'none',
        scrollTrigger: {
          trigger: '.blog-article__hero',
          start: 'top top',
          end: 'bottom top',
          scrub: true,
        },
      });
    }

    // Barre de progression : l'écouteur précédent est retiré à chaque navigation
    progressController?.abort();
    progressController = null;
    if (progressEl) {
      progressController = new AbortController();
      const updateProgress = (): void => {
        const scrollTop = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
        progressEl.style.width = `${progress}%`;
      };

      window.addEventListener('scroll', updateProgress, { passive: true, signal: progressController.signal });
      updateProgress();
    }
  }

  // astro:page-load se déclenche au premier chargement et après chaque navigation (view transitions)
  document.addEventListener('astro:page-load', initBlogArticle);
</script>
