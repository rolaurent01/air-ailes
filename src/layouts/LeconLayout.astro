---
import BaseLayout from './BaseLayout.astro';
import FilAriane from '../components/FilAriane.astro';
import NavParcours from '../components/NavParcours.astro';

interface Lien {
  href: string;
  etiquette: string;
  titre: string;
}

interface Props {
  title: string;
  slug: string;
  date: Date;
  misAJour: Date;
  excerpt: string;
  coverSvg: string;
  /** Ex. « Module 1 · Leçon 3 » */
  badge: string;
  niveau: string;
  tempsLecture: number;
  filAriane: { libelle: string; href?: string }[];
  precedent: Lien;
  suivant: Lien;
}

const {
  title, slug, date, misAJour, excerpt, coverSvg, badge, niveau, tempsLecture, filAriane, precedent, suivant,
} = Astro.props;

const misAJourTexte = misAJour.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout
  title={title}
  description={excerpt}
  ogImage={`/og/${slug}.png`}
  type="article"
  publishedDate={date.toISOString()}
  modifiedDate={misAJour.toISOString()}
>
  <div class="blog-progress" id="blog-progress"></div>

  <article class="blog-article">
    <header class="blog-article__hero">
      <div class="blog-article__cover" id="blog-cover">
        <img src={coverSvg} alt="" width="600" height="400" />
      </div>
      <div class="blog-article__hero-gradient"></div>
      <div class="blog-article__hero-content">
        <FilAriane elements={filAriane} />
        <h1 class="blog-article__title" id="blog-title">{title}</h1>
        <div class="blog-article__meta">
          <span class="blog-article__tags">
            <span class="blog-article__tag">{badge}</span>
            <span class="blog-article__tag">{niveau}</span>
          </span>
          <span>{tempsLecture} min de lecture</span>
          <span>Mis à jour le <time datetime={misAJour.toISOString()}>{misAJourTexte}</time></span>
        </div>
      </div>
    </header>

    <div class="blog-article__prose">
      <slot />
    </div>

    <NavParcours precedent={precedent} suivant={suivant} ariaLabel="Navigation entre les leçons" />
  </article>
</BaseLayout>

<style>
  /* --- Progress bar --- */
  .blog-progress {
    position: fixed;
    top: 0;
    left: 0;
    width: 0%;
    height: 2px;
    background: var(--color-text-primary);
    z-index: 9999;
    transition: none;
    pointer-events: none;
    opacity: 0.6;
  }

  /* --- Hero --- */
  .blog-article__hero {
    position: relative;
    height: 70vh;
    min-height: 400px;
    max-height: 700px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .blog-article__cover {
    position: absolute;
    inset: 0;
    will-change: transform;
  }

  .blog-article__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .blog-article__hero-gradient {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to bottom,
      rgba(5, 5, 5, 0.1) 0%,
      rgba(5, 5, 5, 0.5) 60%,
      rgba(5, 5, 5, 0.9) 100%
    );
  }

  .blog-article__hero-content {
    position: relative;
    z-index: 2;
    padding: var(--space-xl) var(--container-padding);
    max-width: var(--container-max);
    margin-inline: auto;
    width: 100%;
  }

  .blog-article__hero-content :global(.fil-ariane) {
    margin-bottom: var(--space-sm);
  }

  .blog-article__title {
    font-size: clamp(1.8rem, 5vw, var(--font-size-2xl));
    font-weight: var(--font-weight-light);
    letter-spacing: var(--letter-spacing-wide);
    color: var(--color-text-primary);
    max-width: 20ch;
    opacity: 0;
    transform: translateY(20px);
  }

  .blog-article__meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-top: var(--space-sm);
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
  }

  .blog-article__meta {
    flex-wrap: wrap;
  }

  .blog-article__tags {
    display: flex;
    gap: 8px;
  }

  .blog-article__tag {
    padding: 2px 8px;
    border: 1px solid rgba(240, 237, 232, 0.1);
    border-radius: 2px;
    font-size: var(--font-size-xs);
  }

  /* --- Prose --- */
  .blog-article__prose {
    max-width: 65ch;
    margin-inline: auto;
    padding: var(--space-2xl) var(--container-padding);
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--color-text-primary);
  }

  .blog-article__prose :global(h2) {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-light);
    letter-spacing: var(--letter-spacing-wide);
    margin-top: 4rem;
    margin-bottom: var(--space-md);
    color: var(--color-text-primary);
  }

  .blog-article__prose :global(h3) {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-regular);
    margin-top: var(--space-lg);
    margin-bottom: var(--space-sm);
    color: var(--color-text-primary);
  }

  .blog-article__prose :global(p) {
    margin-bottom: 1.5em;
    max-width: none;
  }

  .blog-article__prose :global(blockquote) {
    border-left: 1px solid var(--color-text-secondary);
    padding-left: var(--space-md);
    font-style: italic;
    opacity: 0.8;
    margin-block: var(--space-lg);
  }

  .blog-article__prose :global(img) {
    width: 100%;
    border-radius: 4px;
    margin-block: var(--space-lg);
  }

  .blog-article__prose :global(a) {
    color: var(--color-text-primary);
    text-decoration: none;
    border-bottom: 1px solid rgba(240, 237, 232, 0.3);
    transition: border-color var(--duration-hover) var(--ease-out-expo);
  }

  .blog-article__prose :global(a:hover) {
    border-color: var(--color-text-primary);
  }

  /* --- SVG Illustrations --- */
  .blog-article__prose :global(.svg-illustration) {
    display: flex;
    justify-content: center;
    margin-block: var(--space-xl);
  }

  .blog-article__prose :global(.svg-illustration svg) {
    max-width: 600px;
    width: 100%;
    height: auto;
  }

  .blog-article__prose :global(.svg-caption) {
    text-align: center;
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
    letter-spacing: var(--letter-spacing-wide);
    margin-top: var(--space-xs);
    font-style: italic;
  }

  /* --- Pour aller plus loin links --- */
  .blog-article__prose :global(h2:last-of-type + p a),
  .blog-article__prose :global(.further-reading a) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  /* --- Ordered/Unordered lists --- */
  .blog-article__prose :global(ol),
  .blog-article__prose :global(ul) {
    padding-left: 1.5em;
    margin-bottom: 1.5em;
  }

  .blog-article__prose :global(li) {
    margin-bottom: 0.5em;
    line-height: 1.7;
  }

  .blog-article__prose :global(strong) {
    font-weight: var(--font-weight-regular);
    color: var(--color-text-primary);
  }

</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { ANIMATION_EASING } from '../lib/constants';

  gsap.registerPlugin(ScrollTrigger);

  let progressController: AbortController | null = null;

  function initBlogArticle(): void {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const titleEl = document.getElementById('blog-title');
    if (!titleEl) {
      progressController?.abort();
      progressController = null;
      return;
    }
    ScrollTrigger.getAll().forEach((t) => t.kill());
    const coverEl = document.getElementById('blog-cover');
    const progressEl = document.getElementById('blog-progress');

    if (titleEl && !reducedMotion) {
      gsap.to(titleEl, {
        opacity: 1, y: 0, duration: 0.6, delay: 0.3, ease: ANIMATION_EASING,
      });
    } else if (titleEl) {
      titleEl.style.opacity = '1';
      titleEl.style.transform = 'none';
    }

    if (coverEl && !reducedMotion) {
      gsap.to(coverEl, {
        yPercent: 15,
        ease: 'none',
        scrollTrigger: {
          trigger: '.blog-article__hero',
          start: 'top top',
          end: 'bottom top',
          scrub: true,
        },
      });
    }

    // Barre de progression : l'écouteur précédent est retiré à chaque navigation
    progressController?.abort();
    progressController = null;
    if (progressEl) {
      progressController = new AbortController();
      const updateProgress = (): void => {
        const scrollTop = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
        progressEl.style.width = `${progress}%`;
      };

      window.addEventListener('scroll', updateProgress, { passive: true, signal: progressController.signal });
      updateProgress();
    }
  }

  // astro:page-load se déclenche au premier chargement et après chaque navigation (view transitions)
  document.addEventListener('astro:page-load', initBlogArticle);
</script>
